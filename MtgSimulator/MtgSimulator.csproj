<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0, not 10: Godot's Android export template refuses anything newer. Commands.md, "Android build". -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\MtgCore\MtgCore.csproj" />
  </ItemGroup>

  <!-- Lets tests reach internal helpers (softmax sampling, pair keys) without
       widening the public API just to make them testable. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MtgSimulator.Tests" />
  </ItemGroup>


</Project>
