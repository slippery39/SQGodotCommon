<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <!-- net9.0, not 10: Godot's Android export template refuses anything newer. Commands.md, "Android build". -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Android publish emits deps.json for each referenced project in both the RID and non-RID
         output dirs; without this NETSDK1152 fails the export. Contents are identical. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MtgCore\MtgCore.csproj" />
    <ProjectReference Include="..\MtgSimulator\MtgSimulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.18.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="R3" Version="1.2.9" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>
</Project>